# Resend API key used to email booking inquiries. Without it, inquiries are
# just logged to the console (useful for local dev).
RESEND_API_KEY=

# Where inquiry emails are sent.
OWNER_EMAIL=you@example.com

# Optional. Defaults to Resend's shared test sender if unset. Once you
# verify a domain in Resend, point this at an address on that domain.
RESEND_FROM="Riglia Villas <onboarding@resend.dev>"
